{
  "@context": {
    "@version": 1.1,

    "xsd":      "http://www.w3.org/2001/XMLSchema#",
    "dct":      "http://purl.org/dc/terms/",
    "schema":   "https://schema.org/",
    "iscc_ont": "https://schema.iscc.codes/terms/",
    "liccium":  "https://w3id.org/liccium/ont/",
    "tdm":      "https://www.w3.org/ns/tdmrep/",
    "cc":       "https://creativecommons.org/ns#",
    "iptc_spec": "https://iptc.org/std/photometadata/specification/",
    "cred":     "https://www.w3.org/2018/credentials#",
    "sec":      "https://w3id.org/security#",
    "faia_ont": "https://w3id.org/faia-framework/faia_ont/",
    "faia_vocab": "https://w3id.org/faia-framework/faia_vocab/",

    "iscc": {
      "@id":   "iscc_ont:iscc",
      "@type": "xsd:string"
    },
    "name": {
      "@id":   "dct:title",
      "@type": "xsd:string"
    },
    "description": {
      "@id":   "dct:description",
      "@type": "xsd:string"
    },
    "timestamp": {
      "@id":   "http://www.w3.org/ns/prov#generatedAtTime",
      "@type": "xsd:integer"
    },
    "declarerId": {
      "@id":   "liccium:declarerId",
      "@type": "xsd:string"
    },
    "regId": {
      "@id":   "liccium:regId",
      "@type": "xsd:string"
    },
    "declarationIdVersion": {
      "@id":   "liccium:declarationIdVersion",
      "@type": "xsd:string"
    },

    "mode":        { "@id": "iscc_ont:mode",     "@type": "xsd:string" },
    "filename":    { "@id": "iscc_ont:filename",  "@type": "xsd:string" },
    "filesize":    { "@id": "iscc_ont:filesize",  "@type": "xsd:integer" },
    "mediatype":   { "@id": "iscc_ont:mediatype", "@type": "xsd:string" },
    "width":       { "@id": "schema:width",       "@type": "xsd:integer" },
    "height":      { "@id": "schema:height",      "@type": "xsd:integer" },
    "thumbnail":   { "@id": "schema:thumbnail",   "@type": "xsd:string" },
    "metahash":    { "@id": "iscc_ont:metahash",  "@type": "xsd:string" },
    "datahash":    { "@id": "iscc_ont:datahash",  "@type": "xsd:string" },
    "sourceUrl":   { "@id": "schema:contentUrl",  "@type": "@id" },
    "redirect":    { "@id": "schema:url",         "@type": "@id" },
    "license":     { "@id": "cc:license",         "@type": "@id" },
    "acquire":     { "@id": "cc:morePermissions", "@type": "@id" },
    "original":    { "@id": "liccium:original",   "@type": "xsd:boolean" },
    "redacted":    { "@id": "liccium:redacted",   "@type": "xsd:boolean" },
    "version":     { "@id": "dct:hasVersion",     "@type": "xsd:integer" },
    "entryID":     { "@id": "liccium:entryID",    "@type": "xsd:string" },
    "entryUUID":   { "@id": "liccium:entryID",    "@type": "xsd:string" },
    "supersedes":  { "@id": "dct:replaces",       "@type": "xsd:string" },

    "credentials": {
      "@id":        "cred:verifiableCredential",
      "@container": "@set",
      "@context": {
        "id":                "@id",
        "issuer":            { "@id": "cred:issuer",            "@type": "xsd:string" },
        "validFrom":         { "@id": "cred:validFrom",         "@type": "xsd:dateTime" },
        "validUntil":        { "@id": "cred:validUntil",        "@type": "xsd:dateTime" },
        "credentialSubject": { "@id": "cred:credentialSubject" },
        "credentialSchema":  { "@id": "cred:credentialSchema" },
        "proof":             { "@id": "sec:proof" }
      }
    },

    "liccium_plugins": {
      "@id": "liccium:plugins",
      "@context": {
        "tdmrep": {
          "@id": "liccium:tdmPolicy",
          "@context": {
            "tdm-reservation": { "@id": "liccium:tdm-reservation", "@type": "xsd:integer" },
            "tdm-policy":      { "@id": "liccium:tdm-policy",      "@type": "@id" }
          }
        },
        "iptc": {
          "@id": "iptc_spec:PhotoMetadata",
          "@context": {
            "digitalsourcetype":  { "@id": "iptc_spec:digitalSourceType",   "@type": "@id" },
            "keywords":           { "@id": "iptc_spec:keywords",            "@type": "xsd:string" },
            "creator":            { "@id": "dct:creator",              "@type": "xsd:string" },
            "credit":             { "@id": "iptc_spec:creditLine",          "@type": "xsd:string" },
            "creditText":         { "@id": "iptc_spec:creditLine",          "@type": "xsd:string" },
            "copyrightNotice":    { "@id": "dct:rights",               "@type": "xsd:string" },
            "acquireLicensePage": { "@id": "cc:morePermissions",       "@type": "@id" },
            "webstatementRights": { "@id": "cc:license",               "@type": "@id" }
          }
        },
        "creative_commons": {
          "@id": "cc:License",
          "@context": {
            "value":     { "@id": "liccium:ccLicenseCode", "@type": "xsd:string" },
            "deed":      { "@id": "cc:deed",               "@type": "@id" },
            "deed_code": { "@id": "cc:legalcode",          "@type": "@id" }
          }
        },
        "faia": {
          "@id": "faia_ont:faiaMetadata",
          "@context": {
            "faiaFlag": {
              "@id":   "faia_ont:faiaFlag",
              "@type": "@vocab",
              "@context": {
                "hcc": { "@id": "faia_vocab:HCC" },
                "aac": { "@id": "faia_vocab:AAC" },
                "aig": { "@id": "faia_vocab:AIG" },
                "HCC": { "@id": "faia_vocab:HCC" },
                "AAC": { "@id": "faia_vocab:AAC" },
                "AIG": { "@id": "faia_vocab:AIG" }
              }
            },
            "activityCode": {
              "@id":   "faia_ont:activityCode",
              "@type": "@vocab",
              "@context": {
                "coCreation":     { "@id": "faia_vocab:Co-Creation" },
                "contribution":   { "@id": "faia_vocab:Contribution" },
                "enhancement":    { "@id": "faia_vocab:Enhancement" },
                "refinement":     { "@id": "faia_vocab:Refinement" },
                "transformation": { "@id": "faia_vocab:Transformation" },
                "analysis":       { "@id": "faia_vocab:Analysis" },
                "STM language refinement":     { "@id": "faia_vocab:STM-LanguageRefinement" },
                "STM manuscript drafting":   { "@id": "faia_vocab:STM-ManuscriptDrafting" },
                "STM manuscript translation":    { "@id": "faia_vocab:STM-ManuscriptTranslation" },
                "STM data presentation refinement":     { "@id": "faia_vocab:STM-DataPresentationRefinement" },
                "STM illustrative figure generation": { "@id": "faia_vocab:STM-IllustrativeFigureGeneration" },
                "STM research data visualisation":       { "@id": "faia_vocab:STM-ResearchDataVisualisation" },
                "STM code presentation refinement": { "@id": "faia_vocab:STM-CodePresentationRefinement" },
                "STM reference gathering":       { "@id": "faia_vocab:STM-ReferenceGathering" }
              }
            },
            "systemAttribution": { "@id": "faia_ont:systemAttribution", "@type": "xsd:string" },
            "systemVersion":     { "@id": "faia_ont:systemVersion",     "@type": "xsd:string" }
          }
        }
      }
    }
  }
}
